      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Computers" enabled="true">
        <stringProp name="TestPlan.comments">Machine-account logons: computers getting a TGT and an LDAP service ticket, as at boot and for Group Policy.</stringProp>
        <stringProp name="ThreadGroup.num_threads">${__P(computer.threads,0)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(rampup,10)}</stringProp>
