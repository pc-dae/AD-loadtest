<powershell>
# First domain controller: creates the forest, installs an enterprise CA so domain controllers
# auto-enrol for the certificate LDAPS needs, and seeds the load-test users with the same scheme as
# the Samba lab (docker/samba-dc/seed-users.py) and the chart's users CSV:
#   i % 4 == 0   member of LT-Authorised
#   i % 8 == 1   member of LT-Authorised-Nested, itself a member of LT-Authorised
#   i % 8 == 5   member of LT-Nest-01, a chain of NestDepth groups ending in LT-Authorised
#   otherwise    member of LT-Denied
#   i % 10 == 0  also in RoleGroups LT-Role-nnn groups ("heavy": large Kerberos tickets)
#   i % 50 == 3  disabled; i % 50 == 7 expired
# plus ComputerCount computer accounts LTPC00001$... with the test user password, for machine logons.
# EC2Launch runs this at every boot (persist below); each run carries on after the last reboot.
# Progress is logged to C:\ad-loadtest-setup.log.
$ErrorActionPreference = 'Stop'
Start-Transcript -Path C:\ad-loadtest-setup.log -Append

$ComputerName = '${computer_name}'
$DomainName = '${domain_name}'
$Netbios = '${netbios_name}'
$AdminPassword = ConvertTo-SecureString '${admin_password}' -AsPlainText -Force
$UserPassword = ConvertTo-SecureString '${test_user_password}' -AsPlainText -Force
$UserCount = ${user_count}
$RoleGroups = ${role_groups}
$NestDepth = ${nest_depth}
$ComputerCount = ${computer_count}
$SeededMarker = 'C:\ad-loadtest-seeded.txt'

if ($env:COMPUTERNAME -ne $ComputerName) {
    # The local Administrator becomes the domain Administrator when the forest is created.
    Set-LocalUser -Name Administrator -Password $AdminPassword
    Rename-Computer -NewName $ComputerName -Force
    Restart-Computer -Force
    exit
}

if ((Get-CimInstance Win32_ComputerSystem).DomainRole -lt 4) {
    Install-WindowsFeature AD-Domain-Services, ADCS-Cert-Authority -IncludeManagementTools | Out-Null
    Install-ADDSForest -DomainName $DomainName -DomainNetbiosName $Netbios `
        -SafeModeAdministratorPassword $AdminPassword -InstallDns -Force -NoRebootOnCompletion
    Restart-Computer -Force
    exit
}

${telegraf_setup}

if (Test-Path $SeededMarker) {
    Write-Output 'Domain already set up'
    Stop-Transcript
    exit
}

# AD Web Services takes a little while after boot.
for ($i = 0; $i -lt 60; $i++) {
    try { Get-ADDomain | Out-Null; break } catch { Start-Sleep -Seconds 10 }
}
$UsersOu = 'CN=Users,' + (Get-ADDomain).DistinguishedName

if (-not (Test-Path 'HKLM:\SYSTEM\CurrentControlSet\Services\CertSvc\Configuration')) {
    Install-AdcsCertificationAuthority -CAType EnterpriseRootCA -CACommonName "$Netbios-CA" -Force | Out-Null
}
# Ask for the domain controller certificate now rather than at the next autoenrolment cycle.
certutil -pulse | Out-Null

# Lab policy: load tests reuse the same accounts and send bad passwords on purpose.
Set-ADDefaultDomainPasswordPolicy -Identity $DomainName -LockoutThreshold 0 -MaxPasswordAge 0 `
    -MinPasswordAge 0 -PasswordHistoryCount 0 -ComplexityEnabled $false

$nestGroups = @(1..$NestDepth | ForEach-Object { 'LT-Nest-{0:D2}' -f $_ })
$roleGroupNames = @(if ($RoleGroups -gt 0) { 1..$RoleGroups | ForEach-Object { 'LT-Role-{0:D3}' -f $_ } })
foreach ($group in @('LT-Authorised', 'LT-Authorised-Nested', 'LT-Denied') + $nestGroups + $roleGroupNames) {
    if (-not (Get-ADGroup -Filter "Name -eq '$group'")) {
        New-ADGroup -Name $group -GroupScope Global -Path $UsersOu
    }
}

function Add-Members([string] $Group, [string[]] $Names) {
    $existing = @(Get-ADGroupMember -Identity $Group | Select-Object -ExpandProperty SamAccountName)
    $missing = @($Names | Where-Object { $existing -notcontains $_ })
    if ($missing.Count -gt 0) { Add-ADGroupMember -Identity $Group -Members $missing }
}

Add-Members 'LT-Authorised' @('LT-Authorised-Nested')
# LT-Nest-01 is in LT-Nest-02 ... and the last one is in LT-Authorised.
$outerGroups = @($nestGroups | Select-Object -Skip 1) + 'LT-Authorised'
for ($d = 0; $d -lt $nestGroups.Count; $d++) { Add-Members $outerGroups[$d] @($nestGroups[$d]) }

function New-LoadTestUser([string] $Sam, [bool] $Enabled = $true) {
    if (-not (Get-ADUser -Filter "SamAccountName -eq '$Sam'")) {
        New-ADUser -Name $Sam -SamAccountName $Sam -UserPrincipalName "$Sam@$DomainName" -Path $UsersOu `
            -AccountPassword $UserPassword -Enabled $Enabled -PasswordNeverExpires $true
    }
}

New-LoadTestUser 'svc-ltapp'
$members = @{}
$heavy = @()
for ($i = 1; $i -le $UserCount; $i++) {
    $sam = 'ltuser{0:D5}' -f $i
    New-LoadTestUser $sam -Enabled ($i % 50 -ne 3)
    if ($i % 50 -eq 7) { Set-ADAccountExpiration -Identity $sam -DateTime '2020-01-01' }
    if ($i % 4 -eq 0) { $group = 'LT-Authorised' }
    elseif ($i % 8 -eq 1) { $group = 'LT-Authorised-Nested' }
    elseif ($i % 8 -eq 5) { $group = 'LT-Nest-01' }
    else { $group = 'LT-Denied' }
    if (-not $members.ContainsKey($group)) { $members[$group] = @() }
    $members[$group] += $sam
    if ($i % 10 -eq 0) { $heavy += $sam }
}
foreach ($group in $members.Keys) { Add-Members $group $members[$group] }
if ($heavy.Count -gt 0) {
    foreach ($group in $roleGroupNames) { Add-Members $group $heavy }
}

$ComputersOu = 'CN=Computers,' + (Get-ADDomain).DistinguishedName
for ($i = 1; $i -le $ComputerCount; $i++) {
    $name = 'LTPC{0:D5}' -f $i
    if (-not (Get-ADComputer -Filter "Name -eq '$name'")) {
        New-ADComputer -Name $name -SamAccountName "$name`$" -Path $ComputersOu -AccountPassword $UserPassword -Enabled $true
    }
}

Set-Content -Path $SeededMarker -Value "Seeded $UserCount users, $($heavy.Count) in $RoleGroups role groups, nesting $NestDepth deep, $ComputerCount computers $(Get-Date -Format o)"
Write-Output "Domain $DomainName ready with $UserCount load-test users"
Stop-Transcript
</powershell>
<persist>true</persist>
