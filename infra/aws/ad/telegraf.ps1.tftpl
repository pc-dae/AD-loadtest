# DC metrics for the load-test dashboard and run comparisons: Telegraf reads the system, LSASS, NTDS
# (LDAP), Netlogon (NTLM) and authentication counters and serves them on :${metrics_port} for the
# cluster's Telegraf to scrape. A failure here is logged and retried at the next boot; it never stops
# the domain controller set-up.
try {
    if (-not (Get-Service telegraf -ErrorAction SilentlyContinue)) {
        $TelegrafVersion = '${telegraf_version}'
        $TelegrafSha256 = '${telegraf_sha256}'
        $TelegrafDir = 'C:\Program Files\Telegraf'
        $zip = "$env:TEMP\telegraf.zip"
        [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
        Invoke-WebRequest -UseBasicParsing -OutFile $zip `
            -Uri "https://dl.influxdata.com/telegraf/releases/telegraf-$($TelegrafVersion)_windows_amd64.zip"
        if ((Get-FileHash $zip -Algorithm SHA256).Hash -ne $TelegrafSha256) { throw 'Telegraf download failed its SHA-256 check' }
        Expand-Archive -Path $zip -DestinationPath "$env:TEMP\telegraf" -Force
        New-Item -ItemType Directory -Force -Path $TelegrafDir | Out-Null
        Copy-Item "$env:TEMP\telegraf\telegraf-$TelegrafVersion\telegraf.exe" $TelegrafDir -Force
        Set-Content -Path "$TelegrafDir\telegraf.conf" -Encoding ASCII -Value @'
[agent]
  interval = "5s"
  flush_interval = "5s"

[[outputs.prometheus_client]]
  listen = ":${metrics_port}"
  metric_version = 2
  collectors_exclude = ["gocollector", "process"]

[[inputs.win_perf_counters]]
  [[inputs.win_perf_counters.object]]
    ObjectName = "Processor"
    Instances = ["_Total"]
    Counters = ["% Processor Time"]
    Measurement = "win_cpu"
  [[inputs.win_perf_counters.object]]
    ObjectName = "Memory"
    Instances = ["------"]
    Counters = ["Available MBytes", "% Committed Bytes In Use"]
    Measurement = "win_mem"
  [[inputs.win_perf_counters.object]]
    ObjectName = "Process"
    Instances = ["lsass"]
    Counters = ["% Processor Time", "Working Set", "Handle Count", "Thread Count"]
    Measurement = "win_proc"
  [[inputs.win_perf_counters.object]]
    ObjectName = "NTDS"
    Instances = ["------"]
    Counters = ["LDAP Successful Binds/sec", "LDAP Searches/sec", "LDAP Client Sessions", "LDAP Active Threads",
                "LDAP Bind Time", "ATQ Threads LDAP", "ATQ Threads Total", "ATQ Outstanding Queued Requests",
                "ATQ Request Latency", "ATQ Estimated Queue Delay"]
    Measurement = "win_ntds"
  [[inputs.win_perf_counters.object]]
    ObjectName = "Security System-Wide Statistics"
    Instances = ["------"]
    Counters = ["Kerberos Authentications", "NTLM Authentications"]
    Measurement = "win_auth"
  [[inputs.win_perf_counters.object]]
    ObjectName = "Netlogon"
    Instances = ["_Total"]
    Counters = ["Semaphore Waiters", "Semaphore Holders", "Semaphore Timeouts", "Average Semaphore Hold Time"]
    Measurement = "win_netlogon"
'@
        & "$TelegrafDir\telegraf.exe" --service install --config "$TelegrafDir\telegraf.conf"
        New-NetFirewallRule -DisplayName 'Telegraf metrics' -Direction Inbound -Protocol TCP `
            -LocalPort ${metrics_port} -Action Allow | Out-Null
    }
    Start-Service telegraf
} catch {
    Write-Output "Telegraf set-up failed, will retry at next boot: $_"
}
