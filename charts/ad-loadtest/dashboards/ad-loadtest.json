        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "table",
          "query": "SELECT sum(\"count\") AS \"Samples\", mean(\"avg\") AS \"Mean ms\", max(\"pct95.0\") AS \"Max p95 ms\", max(\"pct99.0\") AS \"Max p99 ms\", max(\"max\") AS \"Max ms\" FROM \"jmeter\" WHERE \"application\" =~ /^$application$/ AND \"transaction\" =~ /^$transaction$/ AND \"transaction\" != 'all' AND \"transaction\" != 'internal' AND \"statut\" = 'all' AND $timeFilter GROUP BY \"transaction\"",
          "alias": "",
